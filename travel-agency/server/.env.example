# Copia este archivo a .env y rellena tus claves de Stripe
# (https://dashboard.stripe.com/apikeys). Usa las claves de prueba
# (sk_test_... / pk_test_...) hasta que actives la cuenta.

# Puerto del servidor
PORT=3000

# Clave secreta de Stripe (NUNCA la subas al repositorio)
STRIPE_SECRET_KEY=

# Clave publicable de Stripe (se envía al navegador)
STRIPE_PUBLISHABLE_KEY=

# Secreto del webhook (https://dashboard.stripe.com/webhooks,
# endpoint: https://tu-dominio/api/webhook, evento: payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=
